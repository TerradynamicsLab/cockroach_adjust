
Fit Group(
	Fit Model(
		Y( :BR ),
		Effects( :phase ),
		Random Effects( :animal ),
		NoBounds( 1 ),
		Personality( "Standard Least Squares" ),
		Method( "REML" ),
		Emphasis( "Minimal Report" ),
		Run(
			:BR << {Summary of Fit( 1 ), Analysis of Variance( 0 ),
			Parameter Estimates( 1 ), Scaled Estimates( 0 ),
			Plot Actual by Predicted( 0 ), Plot Regression( 0 ),
			Plot Residual by Predicted( 0 ), Plot Studentized Residuals( 0 ),
			Plot Effect Leverage( 0 ), Plot Residual by Normal Quantiles( 0 ),
			{:phase << {LSMeans Student's t( 0.05 )}}}
		),
		SendToReport(
			Dispatch( {"Response BR"}, "Summary of Fit", OutlineBox, {Close( 1 )} ),
			Dispatch(
				{"Response BR"},
				"Parameter Estimates",
				OutlineBox,
				{Close( 1 )}
			),
			Dispatch(
				{"Response BR"},
				"REML Variance Component Estimates",
				OutlineBox,
				{Close( 1 )}
			),
			Dispatch(
				{"Response BR", "Effect Details"},
				"phase",
				OutlineBox,
				{Close( 1 )}
			),
			Dispatch(
				{"Response BR", "Effect Details", "phase"},
				"Least Squares Means Table",
				OutlineBox,
				{Close( 1 )}
			),
			Dispatch(
				{"Response BR", "Effect Details"},
				"animal",
				OutlineBox,
				{Close( 1 )}
			),
			Dispatch(
				{"Response BR", "Effect Details", "animal"},
				"Least Squares Means Table",
				OutlineBox,
				{Close( 1 )}
			)
		)
	),
